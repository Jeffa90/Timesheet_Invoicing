# PostgreSQL. Use an Australian region in production — participant data is health-adjacent
# and should stay onshore.
DATABASE_URL="postgresql://user:password@localhost:5432/ndis_timesheets?schema=public"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Transactional email for sending invoices
RESEND_API_KEY=""
INVOICE_FROM_EMAIL="invoices@example.com"
