# PostgreSQL (Supabase, ap-southeast-2 — participant data is health-adjacent and stays onshore).
# DATABASE_URL: pooled connection (Supabase dashboard -> Connect -> "Transaction pooler"), used
# by the app at runtime. DIRECT_URL: direct connection (same dialog -> "Direct connection"),
# used only by `prisma migrate`.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Transactional email for sending invoices
RESEND_API_KEY=""
INVOICE_FROM_EMAIL="invoices@example.com"
